{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User profile with role and contact details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "department": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "permissions": { "type": "object" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "room": {
      "title": "Meeting Room",
      "description": "Details about a meeting room available for booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "capacity": { "type": "integer" },
        "equipment": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["id", "name", "capacity", "status"]
    },
    "booking": {
      "title": "Room Booking",
      "description": "A booking record for a specific room and time slot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "roomName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "purpose": { "type": "string" },
        "attendeesCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "required": ["id", "roomId", "roomName", "userId", "userName", "userEmail", "title", "date", "startTime", "endTime", "status"]
    },
    "notification": {
      "title": "System Notification",
      "description": "An in-app notification for bookings and system actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "isRead", "createdAt"]
    },
    "vehicle": {
      "title": "Administrative Vehicle",
      "description": "Vehicle asset in the government office fleet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "plateNumber": { "type": "string" },
        "type": { "type": "string", "enum": ["sedan", "suv", "van", "pickup", "minibus"] },
        "capacity": { "type": "integer" },
        "fuelType": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "in_use", "maintenance"] },
        "imageUrl": { "type": "string" },
        "defaultDriver": { "type": "string" },
        "driverPhone": { "type": "string" },
        "mileage": { "type": "number" },
        "department": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "plateNumber", "type", "capacity", "status"]
    },
    "vehicle_booking": {
      "title": "Vehicle Booking",
      "description": "Reservation record for official vehicle travel dispatch",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vehicleId": { "type": "string" },
        "vehicleName": { "type": "string" },
        "vehiclePlate": { "type": "string" },
        "vehicleType": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "department": { "type": "string" },
        "phone": { "type": "string" },
        "purpose": { "type": "string" },
        "destination": { "type": "string" },
        "passengersCount": { "type": "integer" },
        "passengersList": { "type": "string" },
        "startDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endDate": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "completed", "cancelled"] },
        "assignedDriver": { "type": "string" },
        "driverPhone": { "type": "string" },
        "adminNotes": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string" }
      },
      "required": ["id", "vehicleId", "userId", "userName", "purpose", "destination", "startDate", "endDate", "status"]
    },
    "leadership_activity": {
      "title": "Leadership & Department Duty Activity",
      "description": "Duty or mission log for provincial office leadership, department heads, and sector chiefs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "roleTitle": { "type": "string" },
        "department": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["meeting", "mission", "inspection", "ceremony", "internal", "training", "other"] },
        "location": { "type": "string" },
        "startDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endDate": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "in_progress", "completed", "cancelled"] },
        "priority": { "type": "string", "enum": ["normal", "important", "urgent"] },
        "participants": { "type": "string" },
        "outcome": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "department", "title", "category", "startDate", "endDate", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile collection, keyed by auth user uid"
    },
    "/rooms/{roomId}": {
      "schema": "room",
      "description": "Meeting rooms available for booking"
    },
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Meeting room bookings"
    },
    "/notifications/{notificationId}": {
      "schema": "notification",
      "description": "In-app notifications for users"
    },
    "/vehicles/{vehicleId}": {
      "schema": "vehicle",
      "description": "Fleet vehicles available for official administrative dispatch"
    },
    "/vehicle_bookings/{bookingId}": {
      "schema": "vehicle_booking",
      "description": "Vehicle booking and mission travel reservations"
    },
    "/leadership_activities/{activityId}": {
      "schema": "leadership_activity",
      "description": "Leadership, department head, and division chief work activities and missions"
    }
  }
}
